# ==============================================================================
# VeriText AI - Environment Configuration Example
# Sistem Deteksi Plagiarisme Cerdas Berbasis Hybrid Lexical & Semantic AI Engine
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME="VeriText AI API"
APP_VERSION="1.0.0"
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173

# Security & JWT Credentials
SECRET_KEY=veritext-ai-super-secret-key-development-minimum-32-chars!
JWT_SECRET_KEY=veritext-jwt-signing-secret-key-development-secure-random!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL with pgvector Configuration
POSTGRES_USER=veritext
POSTGRES_PASSWORD=veritext_secure_pass
POSTGRES_DB=veritext_ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://veritext:veritext_secure_pass@localhost:5432/veritext_ai
SYNC_DATABASE_URL=postgresql://veritext:veritext_secure_pass@localhost:5432/veritext_ai

# Redis & Celery Message Broker Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# AI & Embedding Engine Configuration
SENTENCE_TRANSFORMER_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
RERANKER_ENABLED=True
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_THRESHOLD=0.5
WINNOWING_K_GRAM=5
WINNOWING_WINDOW_SIZE=4
SIMILARITY_LEXICAL_WEIGHT=0.50
SIMILARITY_SEMANTIC_WEIGHT=0.35
SIMILARITY_STYLO_WEIGHT=0.15

# Gemini AI & Web Plagiarism Scanner (Jalur 1)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenRouter API (Free Model Option)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
WEB_SCAN_ENABLED=True
WEB_SCAN_MAX_SENTENCES=120
WEB_SCAN_TIMEOUT_S=25

# Payment Gateway (Midtrans Sandbox Mode)
MIDTRANS_SERVER_KEY=SB-Mid-server-DemoServerKey1234567890
MIDTRANS_CLIENT_KEY=SB-Mid-client-DemoClientKey1234567890
MIDTRANS_IS_PRODUCTION=False
MIDTRANS_MERCHANT_ID=G123456789

# Google OAuth 2.0 (Google Sign-In)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# SMTP Email Configuration (Password Reset & Notifikasi)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=True
EMAILS_FROM_EMAIL=no-reply@veritext.ai
EMAILS_FROM_NAME="VeriText AI"

# Storage & File Handling
UPLOAD_DIR=./uploads
STORAGE_BACKEND=local
MAX_FILE_SIZE_MB=15
ALLOWED_EXTENSIONS=pdf,docx,txt

# Frontend Vite Variables (Used when running Frontend)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Pembatas beban unggahan
MIN_DOCUMENT_WORDS=50
MAX_PDF_PAGES=400
MAX_DOCX_UNCOMPRESSED_MB=50
MAX_DOCX_COMPRESSION_RATIO=100
EXTRACTION_TIMEOUT_SECONDS=30
MAX_ACTIVE_AUDITS_PER_USER=3
UPLOAD_RATE_LIMIT_PER_MINUTE=10
